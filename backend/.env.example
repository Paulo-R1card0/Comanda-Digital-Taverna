# Copie este arquivo para "backend/.env" e ajuste os valores.
# O arquivo .env está no .gitignore e NUNCA deve ir para o GitHub.

SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/comanda?useSSL=false&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=comanda
SPRING_DATASOURCE_PASSWORD=comanda

# Mínimo de 32 caracteres. Gere um aleatório, ex.: openssl rand -base64 48
JWT_SECRET=troque-por-uma-chave-aleatoria-com-mais-de-32-caracteres

# Origens liberadas no CORS (separadas por vírgula)
CORS_ORIGINS=http://localhost:4200
